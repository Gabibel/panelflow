node_modules/
backend/data/
# `.env` alone matches only that exact name — not `.env.local`, which is where
# `vercel env pull` writes by default, nor `.env.production`. The glob is what
# keeps a pulled secret out of a commit.
.env
.env.*
!.env.example
*.log
.DS_Store

# Android
android/build/
android/app/build/
android/.gradle/
android/local.properties

# iOS — the project file and the bundled web layer are both generated
# (`xcodegen generate`, `Scripts/bundle-assets.sh`); committing them would mean
# committing the same JavaScript twice and resolving conflicts in a file nobody
# writes by hand.
ios/Generated/
ios/*.xcodeproj
ios/*.xcworkspace
ios/DerivedData/

.vercel

# Agent configuration is versioned; agent scratch is not. `launch.json` points
# at a throwaway preview server outside the repo, so it means nothing on another
# machine — everything below it is repo knowledge that belongs in the history.
#
# The directory itself must not be ignored (`.claude/*`, not `.claude/`): git
# never looks inside an ignored directory, so the negations below would never be
# read and the whole thing would stay invisible.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
!.claude/agents/
!.claude/mcp/
