node_modules/
backend/data/
# `.env` alone matches only that exact name — not `.env.local`, which is where
# `vercel env pull` writes by default, nor `.env.production`. The glob is what
# keeps a pulled secret out of a commit.
.env
.env.*
!.env.example
*.log
.DS_Store

# Android
android/build/
android/app/build/
android/.gradle/
android/local.properties

# iOS — the project file and the bundled web layer are both generated
# (`xcodegen generate`, `Scripts/bundle-assets.sh`); committing them would mean
# committing the same JavaScript twice and resolving conflicts in a file nobody
# writes by hand.
ios/Generated/
ios/*.xcodeproj
ios/*.xcworkspace
ios/DerivedData/

.vercel

# Local editor/agent scratch: launch.json here points at a throwaway preview
# server outside the repo, so it means nothing on another machine.
.claude/
