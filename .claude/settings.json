{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              ".claude/hooks/guard-generated.mjs"
            ],
            "timeout": 15,
            "statusMessage": "Checking the file is source, not output"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              ".claude/hooks/guard-db.mjs"
            ],
            "timeout": 15,
            "statusMessage": "Checking what this reaches"
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/gabri/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/gabri/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              ".claude/hooks/sync-shared-after-edit.mjs"
            ],
            "timeout": 30,
            "statusMessage": "Republishing shared/"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              ".claude/hooks/tests-before-stop.mjs"
            ],
            "timeout": 120,
            "statusMessage": "Running the suite"
          }
        ]
      }
    ]
  }
}