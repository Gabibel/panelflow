# Copy to .env (or set in the environment) — the app reads process.env directly.
PORT=8787
PANELFLOW_JWT_SECRET=change-me-in-production
# PANELFLOW_DATA_DIR=./data
# PANELFLOW_RULES_PATH=../shared/detection-rules.json

# External tracker OAuth apps (register one per service, secrets stay server-side)
# PANELFLOW_ANILIST_CLIENT_ID=
# PANELFLOW_ANILIST_CLIENT_SECRET=
# PANELFLOW_ANILIST_REDIRECT_URI=http://localhost:8787/api/trackers/anilist/callback
# PANELFLOW_MAL_CLIENT_ID=
# PANELFLOW_MAL_CLIENT_SECRET=
# PANELFLOW_MAL_REDIRECT_URI=http://localhost:8787/api/trackers/mal/callback
