{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["dub1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "{web,shared}/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/watch/run", "schedule": "0 5 * * *" }
  ]
}
