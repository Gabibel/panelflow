  "heuristics": {
    "scoreThreshold": 50,
    "minGalleryImages": 3,
    "minImageWidth": 400,
    "urlPatterns": [
      "/(manga|manhwa|manhua|comic|scan|webtoon)s?/",
      "[/_-](chapter|chapitre|chap|ch)[-_/ ]?\\d+",
      "/read(er)?/",
      "[/_-]episode[-_/]?\\d+"
    ],
    "navTextPatterns": [
      "next chapter",
      "previous chapter",
      "prev chapter",
      "chapitre suivant",
      "chapitre précédent",
      "次の話",
      "前の話"
    ],
    "weights": {
      "imageGallery": 40,
      "urlPattern": 20,
      "chapterNav": 20,
      "lowTextDensity": 10,
      "knownEngine": 40,
      "knownDomain": 100
    }
  },
  "engines": {
    "manganato": {
      "detect": [
        ".container-chapter-reader",
        ".panel-chapter-info-top"
      ],
      "signature": [
        "container-chapter-reader",
        "panel-chapter-info-top"
      ],
      "rule": {
        "imageContainer": ".container-chapter-reader",
        "title": ".story-info-right h1, .panel-chapter-info-top h1",
        "nextChapter": "a.navi-change-chapter-btn-next",
        "prevChapter": "a.navi-change-chapter-btn-prev"
      }
    },
    "themesia": {
      "detect": [
        "#readerarea",
        "#readerarea .ts-main-image"
      ],
      "signature": [
        "readerarea",
        "ts-main-image"
      ],
      "rule": {
        "imageContainer": "#readerarea",
        "title": ".allc a, .entry-title",
        "nextChapter": "a.ch-next-btn",
        "prevChapter": "a.ch-prev-btn"
      }
    },
    "madara": {
      "detect": [
        ".reading-content .wp-manga-chapter-img",
        ".reading-content .page-break"
      ],
      "signature": [
        "wp-manga-chapter",
        "reading-content"
      ],
      "rule": {
        "imageContainer": ".reading-content",
        "title": ".post-title h1, #chapter-heading",
        "nextChapter": ".nav-links .next_page, .select-pagination .nav-next a",
        "prevChapter": ".nav-links .prev_page, .select-pagination .nav-previous a"
      }
    },
    "foolslide": {
      "detect": [
        "#page .inner img",
        "div.reader-nav"
      ],
      "signature": [
        "foolslide"
      ],
      "rule": {
        "imageContainer": "#page",
        "nextChapter": "a.next",
        "prevChapter": "a.prev"
      }
    }
  },
  "domains": {
    "*.mangadex.org": {
      "chapterApi": {
        "from": "/title/([0-9a-fA-F-]{36})",
        "url": "https://api.mangadex.org/manga/$1/aggregate",
