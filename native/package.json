{
  "name": "panelflow-native",
  "version": "0.1.0",
  "main": "index.js",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.20",
    "expo-application": "~57.0.3",
    "expo-background-task": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-notifications": "~57.0.17",
    "expo-sharing": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.16",
    "expo-updates": "~57.0.23",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile preview",
    "submit:ios": "eas submit --platform ios --latest",
