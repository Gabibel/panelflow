+/**
+ * PanelFlow: ad blocking in the in-app browser, before a request leaves the phone.
+ *
+ * Added to react-native-webview by PanelFlow's patch
+ * (native/patches/react-native-webview+13.16.1.patch); it is not part of the
+ * library. react-native-webview offers no hook for the requests a page makes,
+ * only for the pages it navigates to, so PanelFlow's list could only be
+ * enforced from inside the page (native/inject/rn-adblock.js). That is too late
+ * for anything written in the page's own HTML: the browser starts fetching an
+ * advert's script or image while it reads the markup, before any script of
+ * ours can act, and the QA campaign of October 2026 counted five to ten
+ * advertising requests per chapter page on Android (NEW-11). The Chrome
+ * extension blocks the same pages to zero with its declarativeNetRequest list.
+ *
+ * The list is the one the extension uses (shared/adblock-list.json), handed
+ * over by the app through the WebView's `injectedJavaScriptObject` prop as
+ * {"panelflowAdblock": {"hosts": [...], "imageHosts": [...], "whitelist": [...]}}:
+ *   hosts       refused for everything but images
+ *   imageHosts  refused for images too (the list's `images: true` entries;
+ *               the others are left their pictures, because some of them
+ *               also serve chapter pages from a CDN on the same domain)
+ *   whitelist   sites the reader chose to stop blocking on, by page host
+ *
+ * Everything here fails open: a configuration that does not parse, or a
+ * request this cannot judge, is let through. Blocking the page the reader
+ * opened is worse than an advert.
+ */
+final class PanelFlowAdblock {
+
+  private static final String TAG = "PanelFlowAdblock";
+
+  /** The lists, parsed once per configuration string. */
+  private static final class Config {
+    final String source;
+    final Set<String> hosts;
+    final Set<String> imageHosts;
+    final Set<String> whitelist;
+
+    Config(String source, Set<String> hosts, Set<String> imageHosts, Set<String> whitelist) {
+      this.source = source;
+      this.hosts = hosts;
+      this.imageHosts = imageHosts;
+      this.whitelist = whitelist;
+    }
+  }
+
+  private static volatile Config config = null;
+
+  /**
+   * The host of the page each WebView is showing, as seen in its own
+   * main-frame request. WebView.getUrl() cannot be asked from here:
+   * shouldInterceptRequest runs on a background thread, and WebView refuses
+   * every call from a thread other than the one that created it.
+   */
+  private static final Map<WebView, String> pageHosts =
+      Collections.synchronizedMap(new WeakHashMap<WebView, String>());
+
+  private PanelFlowAdblock() {}
+
+  /**
+   * The page a WebView is now showing, from the client's page callbacks (UI
+   * thread). Android does not ask shouldInterceptRequest about the hops of a
+   * redirect, so a series saved under a site's old domain landed on the new
+   * one with the old host remembered, and whitelisting the new domain did
+   * nothing. These callbacks see where the page actually ended up.
+   */
+  static void notePage(WebView view, String url) {
+    try {
+      String host = url == null ? null : Uri.parse(url).getHost();
+      if (host != null && !host.isEmpty()) pageHosts.put(view, host.toLowerCase(Locale.ROOT));
+    } catch (Throwable ignored) {
+      // A page whose address cannot be read keeps the host seen last.
+    }
+  }
+
+  /**
+   * An empty answer for a request PanelFlow refuses, or null to let it go.
+   * Called from RNCWebViewClient.shouldInterceptRequest.
+   */
+  static WebResourceResponse refuse(WebView view, WebResourceRequest request) {
+    try {
+      if (!(view instanceof RNCWebView) || request == null) return null;
+      Uri url = request.getUrl();
+      String host = url == null ? null : url.getHost();
+      if (host == null || host.isEmpty()) return null;
+      host = host.toLowerCase(Locale.ROOT);
+
+      // The page itself is never refused here. Where a page may send the
+      // reader is decided by the app (navigation-policy.js, through
+      // onShouldStartLoadWithRequest); this only remembers where it is.
+      if (request.isForMainFrame()) {
+        pageHosts.put(view, host);
+        return null;
+      }
+
+      Config c = configOf(((RNCWebView) view).injectedJavaScriptObject);
+      if (c == null) return null;
+      String page = pageHosts.get(view);
+      if (page != null && listed(page, c.whitelist)) return null;
+      if (!listed(host, isImage(request) ? c.imageHosts : c.hosts)) return null;
+      return empty();
+    } catch (Throwable t) {
+      Log.w(TAG, "a request could not be judged, so it was let through", t);
+      return null;
+    }
+  }
+
+  /**
+   * Whether a host is on a list: the entry itself or one of its subdomains,
+   * never a host that merely ends with the same letters (`notexample.com` is
+   * not `example.com`). The same rule as rn-adblock.js and the Kotlin shell.
+   */
+  private static boolean listed(String host, Set<String> list) {
+    if (list.isEmpty()) return false;
+    if (list.contains(host)) return true;
+    for (int dot = host.indexOf('.'); dot >= 0; dot = host.indexOf('.', dot + 1)) {
+      if (list.contains(host.substring(dot + 1))) return true;
+    }
+    return false;
+  }
+
+  /**
+   * Whether a request is for an image. WebView does not say what a request is
+   * for; the Accept header Chromium sends for an <img> starts with "image/",
+   * and for nothing else.
+   */
+  private static boolean isImage(WebResourceRequest request) {
+    Map<String, String> headers = request.getRequestHeaders();
+    if (headers == null) return false;
+    String accept = headers.get("Accept");
+    if (accept == null) accept = headers.get("accept");
+    return accept != null && accept.startsWith("image/");
+  }
+
+  /** A fresh empty answer: a response's stream can be read only once. */
+  private static WebResourceResponse empty() {
+    return new WebResourceResponse("text/plain", "utf-8", new ByteArrayInputStream(new byte[0]));
+  }
+
+  /** The configuration for this JSON, parsed now or remembered from last time. */
+  private static Config configOf(String json) {
+    if (json == null || json.isEmpty()) return null;
+    Config cached = config;
+    if (cached != null && json.equals(cached.source)) return cached;
+    synchronized (PanelFlowAdblock.class) {
+      cached = config;
+      if (cached != null && json.equals(cached.source)) return cached;
+      try {
+        JSONObject root = new JSONObject(json);
+        JSONObject adblock = root.optJSONObject("panelflowAdblock");
+        if (adblock == null) return null;
+        Config parsed = new Config(json,
+            hostSet(adblock.optJSONArray("hosts")),
+            hostSet(adblock.optJSONArray("imageHosts")),
+            hostSet(adblock.optJSONArray("whitelist")));
+        config = parsed;
+        return parsed;
+      } catch (Throwable t) {
+        Log.w(TAG, "the ad-block configuration did not parse; nothing is blocked natively", t);
+        return null;
+      }
+    }
+  }
+
+  private static Set<String> hostSet(JSONArray array) {
+    Set<String> out = new HashSet<>();
+    if (array == null) return out;
+    for (int i = 0; i < array.length(); i++) {
+      String host = array.optString(i, "").trim().toLowerCase(Locale.ROOT);
+      if (!host.isEmpty()) out.add(host);
+    }
+    return out;
+  }
+}
