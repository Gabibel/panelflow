+#pragma mark - PanelFlow ad blocking
+//
+// Added by PanelFlow's patch (native/patches/react-native-webview+13.16.1.patch);
+// not part of the library. react-native-webview gives the app no way to refuse
+// the requests a page makes, so PanelFlow enforced its list from inside the
+// page (native/inject/rn-adblock.js), which is too late for anything written
+// in the page's HTML: WebKit fetches it while reading the markup. The QA
+// campaign of October 2026 counted three to six advertising requests per
+// chapter page on iOS (NEW-11). A WKContentRuleList is WebKit's own blocker,
+// the one Safari's content blockers use, and it acts before the request.
+//
+// The list comes from the app through the `injectedJavaScriptObject` prop:
+// {"panelflowAdblock": {"hosts": [...], "imageHosts": [...], "whitelist": [...]}}.
+// Hosts on `hosts` are refused for everything but images, hosts on
+// `imageHosts` for images too, and a page on a whitelisted site is left
+// alone. Everything fails open: a list that does not parse or compile blocks
+// nothing, and the page loads as it would have.
+
+/** The list the app handed over, or nil. */
+- (NSDictionary *)panelflowAdblockConfig
+{
+  if (_injectedJavaScriptObject.length == 0) return nil;
+  NSData *data = [_injectedJavaScriptObject dataUsingEncoding:NSUTF8StringEncoding];
+  if (data == nil) return nil;
+  id parsed = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+  if (![parsed isKindOfClass:[NSDictionary class]]) return nil;
+  id adblock = ((NSDictionary *)parsed)[@"panelflowAdblock"];
+  return [adblock isKindOfClass:[NSDictionary class]] ? adblock : nil;
+}
+
+/** A host as the rules may use it: letters, digits, dots and hyphens only. */
+static NSString *PanelFlowCleanHost(id value)
+{
+  if (![value isKindOfClass:[NSString class]]) return nil;
+  NSString *host = [[(NSString *)value lowercaseString]
+    stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]];
+  if (host.length == 0) return nil;
+  NSCharacterSet *allowed =
+    [NSCharacterSet characterSetWithCharactersInString:@"abcdefghijklmnopqrstuvwxyz0123456789.-"];
+  if ([host rangeOfCharacterFromSet:[allowed invertedSet]].location != NSNotFound) return nil;
+  return host;
+}
+
+/**
+ * The WebKit content-blocker JSON for the list, or nil when there is nothing
+ * to block. The same shape PanelFlow's Swift shell compiles
+ * (scripts/build-adblock.mjs, toSafari), with the images distinction added.
+ */
+- (NSString *)panelflowContentRulesFrom:(NSDictionary *)config
+{
+  NSArray *hosts = [config[@"hosts"] isKindOfClass:[NSArray class]] ? config[@"hosts"] : @[];
+  NSArray *imageHosts = [config[@"imageHosts"] isKindOfClass:[NSArray class]] ? config[@"imageHosts"] : @[];
+  NSArray *whitelist = [config[@"whitelist"] isKindOfClass:[NSArray class]] ? config[@"whitelist"] : @[];
+
+  NSMutableSet *withImages = [NSMutableSet set];
+  for (id value in imageHosts) {
+    NSString *host = PanelFlowCleanHost(value);
+    if (host) [withImages addObject:host];
+  }
+  // Every type but images. Only types WebKit has accepted since iOS 11: a type
+  // it does not know makes the whole list fail to compile.
+  NSArray *notImages = @[@"document", @"script", @"style-sheet", @"font", @"raw",
+                         @"svg-document", @"media", @"popup"];
+
+  NSMutableArray *rules = [NSMutableArray array];
+  for (id value in hosts) {
+    NSString *host = PanelFlowCleanHost(value);
+    if (!host) continue;
+    NSString *escaped = [host stringByReplacingOccurrencesOfString:@"." withString:@"\\."];
+    NSMutableDictionary *trigger = [@{
+      @"url-filter": [NSString stringWithFormat:@"^https?://([a-z0-9-]+\\.)*%@[:/]", escaped],
+      @"load-type": @[@"third-party"],
+    } mutableCopy];
+    if (![withImages containsObject:host]) trigger[@"resource-type"] = notImages;
+    [rules addObject:@{ @"trigger": trigger, @"action": @{ @"type": @"block" } }];
+  }
+  if (rules.count == 0) return nil;
+
+  // A whitelisted site is the page's domain, which is what `if-domain`
+  // matches in a content blocker; "*" takes its subdomains along.
+  NSMutableArray *domains = [NSMutableArray array];
+  for (id value in whitelist) {
+    NSString *host = PanelFlowCleanHost(value);
+    if (host) [domains addObject:[@"*" stringByAppendingString:host]];
+  }
+  if (domains.count > 0) {
+    [rules addObject:@{
+      @"trigger": @{ @"url-filter": @".*", @"if-domain": domains },
+      @"action": @{ @"type": @"ignore-previous-rules" },
+    }];
+  }
+  NSData *json = [NSJSONSerialization dataWithJSONObject:rules options:NSJSONWritingSortedKeys error:nil];
+  return json ? [[NSString alloc] initWithData:json encoding:NSUTF8StringEncoding] : nil;
+}
+
+/**
+ * A name for a list that changes when the list does: FNV-1a over its bytes.
+ * NSString's own hash reads only the ends of a long string, and two lists of
+ * one length that differ in the middle (a whitelist edit) would share it.
+ */
+static NSString *PanelFlowRulesIdentifier(NSString *rules)
+{
+  NSData *bytes = [rules dataUsingEncoding:NSUTF8StringEncoding];
+  const uint8_t *p = bytes.bytes;
+  uint64_t h = 0xcbf29ce484222325ULL; // FNV-1a 64-bit offset basis
+  for (NSUInteger i = 0; i < bytes.length; i++) {
+    h ^= p[i];
+    h *= 1099511628211ULL;
+  }
+  return [NSString stringWithFormat:@"panelflow-adblock-%016llx", (unsigned long long)h];
+}
+
+/**
+ * Compile the list (or find it compiled from a previous launch) and put it on
+ * the web view's content controller, replacing the one in force. Asynchronous,
+ * as WebKit's store is; an answer that arrives after a newer list was asked
+ * for is dropped. Fails open: a list that does not compile leaves nothing in
+ * force, rather than an older list with an older whitelist.
+ */
+- (void)panelflowInstallAdblock:(WKUserContentController *)controller
+{
+  if (controller == nil) return;
+  NSDictionary *config = [self panelflowAdblockConfig];
+  NSString *rules = config ? [self panelflowContentRulesFrom:config] : nil;
+  if (rules == nil) {
+    // Nothing to block any more: take down whatever was in force.
+    if (_panelflowRules != nil) [controller removeContentRuleList:_panelflowRules];
+    _panelflowRules = nil;
+    _panelflowRulesIdentifier = nil;
+    return;
+  }
+  NSString *identifier = PanelFlowRulesIdentifier(rules);
+  if ([identifier isEqualToString:_panelflowRulesIdentifier]) return;
+  _panelflowRulesIdentifier = identifier;
+
+  WKContentRuleListStore *store = [WKContentRuleListStore defaultStore];
+  __weak RNCWebViewImpl *weakSelf = self;
+  __weak WKUserContentController *weakController = controller;
+  void (^apply)(WKContentRuleList *) = ^(WKContentRuleList *list) {
+    RNCWebViewImpl *strongSelf = weakSelf;
+    WKUserContentController *strongController = weakController;
+    if (strongSelf == nil || strongController == nil) return;
+    // A newer list was asked for while this one compiled: that one wins.
+    if (![identifier isEqualToString:strongSelf->_panelflowRulesIdentifier]) return;
+    if (strongSelf->_panelflowRules != nil) {
+      [strongController removeContentRuleList:strongSelf->_panelflowRules];
+      strongSelf->_panelflowRules = nil;
+    }
+    if (list == nil) {
+      // Did not compile: block nothing rather than block by an old list, and
+      // let the next change try again.
+      strongSelf->_panelflowRulesIdentifier = nil;
+      return;
+    }
+    [strongController addContentRuleList:list];
+    strongSelf->_panelflowRules = list;
+    // Lists compiled for an older whitelist are not needed by the next launch
+    // either; the store keeps them on disk until they are removed.
+    [store getAvailableContentRuleListIdentifiers:^(NSArray<NSString *> *identifiers) {
+      for (NSString *old in identifiers) {
+        if ([old hasPrefix:@"panelflow-adblock-"] && ![old isEqualToString:identifier]) {
+          [store removeContentRuleListForIdentifier:old completionHandler:^(NSError *error) {}];
+        }
+      }
+    }];
+  };
+  // WebKit answers on the main thread; the check keeps that an assumption
+  // this code does not depend on, without a hop that would let the first
+  // page load start before the rules are in place.
+  void (^install)(WKContentRuleList *) = ^(WKContentRuleList *list) {
+    if ([NSThread isMainThread]) apply(list);
+    else dispatch_async(dispatch_get_main_queue(), ^{ apply(list); });
+  };
+  [store lookUpContentRuleListForIdentifier:identifier
+                          completionHandler:^(WKContentRuleList *found, NSError *lookupError) {
+    if (found != nil) {
+      install(found);
+      return;
+    }
+    [store compileContentRuleListForIdentifier:identifier
+                        encodedContentRuleList:rules
+                             completionHandler:^(WKContentRuleList *list, NSError *error) {
+      if (error != nil) NSLog(@"[PanelFlow] the ad-block rules did not compile: %@", error);
+      install(list);
+    }];
+  }];
 }
 
 - (void)setEnableApplePay:(BOOL)enableApplePay {
