{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "declarativeNetRequest", "favicon"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "toggle_reader": {
      "suggested_key": { "default": "Alt+R" },
      "description": "__MSG_commandToggleReader__"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/popup-guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["i18n.js", "shared/series-match.js", "shared/site-rules.js", "content/detect.js", "content/library-modal.js", "content/reader.js"],
      "css": ["content/reader.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://panelflow-backend.vercel.app/*", "http://localhost:8787/*"],
      "js": ["content/site-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "adblock_base", "enabled": true, "path": "rules/adblock.json" }
    ]
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup/popup.html", "default_title": "PanelFlow" },
  "options_page": "options/options.html"
}
