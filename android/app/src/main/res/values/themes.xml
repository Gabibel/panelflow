<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark by default and dark only. The reader is the app's reason to exist
         and it is a dark surface; a light chrome around it would flash white on
         every launch and on every return from a chapter. Tokens match
         mobile/www/app.css so the native bar and the web shell are one surface. -->
    <style name="Theme.PanelFlow" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#e87f56</item>
        <item name="colorOnPrimary">#1c1917</item>
        <item name="android:colorBackground">#1c1917</item>
        <item name="colorSurface">#262220</item>
        <item name="colorOnSurface">#fafaf9</item>
        <item name="android:statusBarColor">#1c1917</item>
        <item name="android:navigationBarColor">#1c1917</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
