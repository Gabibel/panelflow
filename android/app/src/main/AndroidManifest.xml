<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Runtime-requested on Android 13+; the chapter check is the only notifier. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PanelFlowApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PanelFlow">

        <!-- The library is the app. Tapping the icon lands here, not on a browser. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The in-app browser: a scan site with the reader injected into it. -->
        <activity
            android:name=".BrowserActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <!-- Sharing a chapter link from any app opens it here, reader and all. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!--
                 Tapping a chapter link elsewhere on the phone offers PanelFlow.
                 The hosts are listed one by one, and that is the point: this
                 filter used to be two bare <data android:scheme> lines, which
                 declared PanelFlow a general-purpose browser and put it in the
                 "Open with" list of every link on the device — a bank, a work
                 intranet, anything. Nobody asked for that and nobody wants it.

                 The list comes from shared/detection-rules.json and is allowed
                 to lag it: a site added there still works, it is just not
                 offered from the chooser until the next release, because a
                 manifest cannot be updated server-side. Sharing a link into the
                 app (the SEND filter above) never needed the list at all.
                 backend/test/android-intents.test.js keeps the two in step.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="3asq.org" />
                <data android:host="*.3asq.org" />
                <data android:host="asurascans.com" />
                <data android:host="*.asurascans.com" />
                <data android:host="azorafly.com" />
                <data android:host="*.azorafly.com" />
                <data android:host="bato.to" />
                <data android:host="*.bato.to" />
                <data android:host="comick.io" />
                <data android:host="*.comick.io" />
                <data android:host="crunchyscan.fr" />
                <data android:host="*.crunchyscan.fr" />
                <data android:host="flamecomics.xyz" />
                <data android:host="*.flamecomics.xyz" />
                <data android:host="ikigaimangas.com" />
                <data android:host="*.ikigaimangas.com" />
                <data android:host="inmanga.com" />
